{
  "permissions": {
    "allow": [
      "PowerShell(.\\gradlew.bat *)",
      "Bash(./gradlew *)",
      "Bash(./gradlew.bat *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(wc *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./local.properties)"
    ]
  }
}
