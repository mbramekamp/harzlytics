# Kopie als ".env" im Projektordner anlegen (wird nicht eingecheckt).
# Nur den öffentlichen Schlüssel eintragen (sb_publishable_... oder der Legacy-anon-Key).
# NIE einen sb_secret_- oder service_role-Schlüssel verwenden: er würde in die App eingebaut.
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_...
